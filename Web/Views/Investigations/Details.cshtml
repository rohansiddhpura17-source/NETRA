@model InvestigationWorkspaceViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Investigation Workspace";
    var c = Model.Case;

    string StatusDotClass(string status) => status switch
    {
        "Open" => "netra-text-info",
        "UnderInvestigation" => "netra-text-primary",
        "PendingReview" => "netra-text-warning",
        "Closed" => "netra-text-success",
        "Reopened" => "netra-text-danger",
        _ => "netra-faint"
    };

    string SeverityTextClass(string severity) => severity switch
    {
        "Critical" => "netra-text-danger",
        "High" => "netra-text-warning",
        "Medium" => "netra-text-info",
        "Low" => "netra-text-success",
        _ => "netra-faint"
    };
}

@await Html.PartialAsync("_Breadcrumbs", new BreadcrumbsModel
{
    Items = new List<BreadcrumbItemModel>
    {
        new() { Text = "Operations" },
        new() { Text = "Crime Cases", Url = Url.Action("Index", "Cases") },
        new() { Text = c.CaseNumber, Url = Url.Action("Details", "Cases", new { id = Model.CaseId }) },
        new() { Text = "Investigation Workspace" }
    }
})

@await Html.PartialAsync("_PageHeader", new PageHeaderModel
{
    Title = c.Title,
    Subtitle = $"{c.CaseNumber} · {c.CrimeTypeName}",
    Meta = (HtmlString)Html.Raw(
        $"<span class=\"netra-dotline\"><span class=\"netra-dotline__dot {StatusDotClass(c.Status)}\" " +
        $"aria-hidden=\"true\"></span>Status: {HtmlEncoder.Default.Encode(NetraDisplay.Words(c.Status))}</span>" +
        $"<span>District: {HtmlEncoder.Default.Encode(c.DistrictName ?? "—")}</span>" +
        $"<span class=\"{SeverityTextClass(c.Severity)}\">Severity: {HtmlEncoder.Default.Encode(c.Severity)}</span>"),
    Actions = (HtmlString)Html.Raw(
        $"<a class=\"netra-btn netra-btn--outline netra-btn--sm\" href=\"/Cases/Details/{Model.CaseId}\">Back to case</a>" +
        (Model.CanEdit
            ? $" <a class=\"netra-btn netra-btn--primary netra-btn--sm\" href=\"/Cases/Edit/{Model.CaseId}\">Update case</a>"
            : string.Empty))
})

@if (TempData["Netra.Success"] is string success)
{
    <div class="netra-alert netra-alert--success netra-mb-4" role="status">
        <span class="netra-alert__icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Info))</span>
        <div class="netra-alert__body">@success</div>
    </div>
}
@if (TempData["Netra.Error"] is string error)
{
    <div class="netra-alert netra-alert--danger netra-mb-4" role="alert">
        <span class="netra-alert__icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Alert))</span>
        <div class="netra-alert__body">@error</div>
    </div>
}

@* ------------------------------------------------------- CASE OVERVIEW *@
<div class="netra-card netra-mb-4">
    <div class="netra-card__header">
        <h2 class="netra-card__title">
            <span class="netra-card__title-icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Cases))</span>
            Case Overview
        </h2>
    </div>
    <div class="netra-card__body">
        <div class="netra-grid" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:var(--netra-space-4);">
            <div>
                <span class="netra-label">Case number</span>
                <div class="netra-mono">@c.CaseNumber</div>
            </div>
            <div>
                <span class="netra-label">Crime type</span>
                <div>@c.CrimeTypeName</div>
            </div>
            <div>
                <span class="netra-label">Incident date</span>
                <div>@c.IncidentDate.ToString("dd MMM yyyy")</div>
            </div>
            <div>
                <span class="netra-label">Severity</span>
                <div>@c.Severity</div>
            </div>
            <div>
                <span class="netra-label">Investigator</span>
                <div>@(c.InvestigatorName ?? "Unassigned")</div>
            </div>
            <div>
                <span class="netra-label">District</span>
                <div>@(c.DistrictName ?? "—")</div>
            </div>
        </div>
    </div>
</div>

<div class="netra-grid netra-grid--2 netra-mb-4">
    @* ------------------------------------------------ VICTIM INFORMATION *@
    <div class="netra-card">
        <div class="netra-card__header">
            <h2 class="netra-card__title">
                <span class="netra-card__title-icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Persons))</span>
                Victim Information
            </h2>
        </div>
        <div class="netra-card__body netra-card__body--flush">
            @if (Model.Victims.Count == 0)
            {
                <div class="netra-empty">
                    <span class="netra-empty__icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Persons))</span>
                    <p class="netra-empty__title">No victims recorded</p>
                    <p class="netra-empty__text">Associate a person with the Victim role.</p>
                </div>
            }
            else
            {
                <ul style="list-style:none;margin:0;padding:0;">
                    @foreach (var person in Model.Victims)
                    {
                        <li style="padding:var(--netra-space-3) var(--netra-space-4);border-bottom:1px solid var(--netra-border);">
                            <div class="netra-table__primary">@person.FullName</div>
                            <div class="netra-faint" style="font-size:11.5px;">
                                @(person.NationalIdNumber ?? "No national ID") ·
                                @(person.DateOfBirth ?? "No date of birth")
                            </div>
                            @if (!string.IsNullOrWhiteSpace(person.Notes))
                            {
                                <p class="netra-muted" style="margin:4px 0 0;font-size:12px;">@person.Notes</p>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    @* ---------------------------------------------------- MODUS OPERANDI *@
    <div class="netra-card">
        <div class="netra-card__header">
            <h2 class="netra-card__title">
                <span class="netra-card__title-icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Investigation))</span>
                Modus Operandi
            </h2>
        </div>
        <div class="netra-card__body">
            <p class="netra-muted">@(c.ModusOperandi ?? "Not recorded.")</p>

            @if (!string.IsNullOrWhiteSpace(c.Description))
            {
                <div class="netra-divider"></div>
                <span class="netra-label">Incident description</span>
                <p class="netra-muted">@c.Description</p>
            }
        </div>
    </div>
</div>

@* --------------------------------------- PERSONS OF INTEREST / SUSPECTS *@
<div class="netra-grid netra-grid--2 netra-mb-4">
    <div class="netra-card">
        <div class="netra-card__header">
            <h2 class="netra-card__title">
                <span class="netra-card__title-icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Alert))</span>
                Suspects
            </h2>
            <span class="netra-faint" style="font-size:11px;">Association is not proof of guilt.</span>
        </div>
        <div class="netra-card__body netra-card__body--flush">
            @if (Model.Suspects.Count == 0)
            {
                <div class="netra-empty">
                    <span class="netra-empty__icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Persons))</span>
                    <p class="netra-empty__title">No suspects recorded</p>
                </div>
            }
            else
            {
                <ul style="list-style:none;margin:0;padding:0;">
                    @foreach (var person in Model.Suspects)
                    {
                        <li style="padding:var(--netra-space-3) var(--netra-space-4);border-bottom:1px solid var(--netra-border);">
                            <div class="netra-row netra-row--between">
                                <span class="netra-table__primary">@person.FullName</span>
                                @await Html.PartialAsync("_StatusBadge", new StatusBadgeModel
                                {
                                    Text = person.Role, Tone = NetraTone.Warning
                                })
                            </div>
                            <div class="netra-faint" style="font-size:11.5px;">
                                Added @person.AssociatedAt.ToString("dd MMM yyyy")
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="netra-card">
        <div class="netra-card__header">
            <h2 class="netra-card__title">
                <span class="netra-card__title-icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Persons))</span>
                Persons of Interest
            </h2>
        </div>
        <div class="netra-card__body netra-card__body--flush">
            @if (Model.PersonsOfInterest.Count == 0 && Model.OtherPersons.Count == 0)
            {
                <div class="netra-empty">
                    <span class="netra-empty__icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Persons))</span>
                    <p class="netra-empty__title">No persons of interest</p>
                </div>
            }
            else
            {
                <ul style="list-style:none;margin:0;padding:0;">
                    @foreach (var person in Model.PersonsOfInterest.Concat(Model.OtherPersons))
                    {
                        <li style="padding:var(--netra-space-3) var(--netra-space-4);border-bottom:1px solid var(--netra-border);">
                            <div class="netra-row netra-row--between">
                                <span class="netra-table__primary">@person.FullName</span>
                                @await Html.PartialAsync("_StatusBadge", new StatusBadgeModel
                                {
                                    Text = person.Role, Tone = NetraTone.Neutral, ShowDot = false
                                })
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

@* ----------------------------------------------------------- LOCATIONS *@
<div class="netra-card netra-mb-4">
    <div class="netra-card__header">
        <h2 class="netra-card__title">
            <span class="netra-card__title-icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Map))</span>
            Locations
        </h2>
    </div>
    <div class="netra-card__body netra-card__body--flush">
        @if (Model.SceneLocations.Count == 0 && Model.RelatedLocations.Count == 0)
        {
            <div class="netra-empty">
                <span class="netra-empty__icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Map))</span>
                <p class="netra-empty__title">No locations recorded</p>
            </div>
        }
        else
        {
            <div class="netra-tablewrap">
                <table class="netra-table">
                    <caption class="netra-sr-only">Scene and related locations</caption>
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Category</th>
                            <th scope="col">District</th>
                            <th scope="col">Coordinates</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var location in Model.SceneLocations)
                        {
                            <tr>
                                <td class="netra-table__primary">@location.Name</td>
                                <td>
                                    @await Html.PartialAsync("_StatusBadge", new StatusBadgeModel
                                    {
                                        Text = "Scene", Tone = NetraTone.Primary, ShowDot = false
                                    })
                                </td>
                                <td>@(location.DistrictName ?? "—")</td>
                                <td class="netra-mono netra-faint">
                                    @(location.Latitude.HasValue && location.Longitude.HasValue
                                        ? $"{location.Latitude:0.#####}, {location.Longitude:0.#####}" : "—")
                                </td>
                            </tr>
                        }
                        @foreach (var location in Model.RelatedLocations)
                        {
                            <tr>
                                <td class="netra-table__primary">@location.Name</td>
                                <td>
                                    @await Html.PartialAsync("_StatusBadge", new StatusBadgeModel
                                    {
                                        Text = location.LocationRole ?? "Related",
                                        Tone = NetraTone.Neutral, ShowDot = false
                                    })
                                </td>
                                <td>@(location.DistrictName ?? "—")</td>
                                <td class="netra-mono netra-faint">
                                    @(location.Latitude.HasValue && location.Longitude.HasValue
                                        ? $"{location.Latitude:0.#####}, {location.Longitude:0.#####}" : "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ------------------------------------------------- TIMELINE AND NOTES *@
<div class="netra-grid netra-grid--2 netra-mb-4">
    <div class="netra-card">
        <div class="netra-card__header">
            <h2 class="netra-card__title">
                <span class="netra-card__title-icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Cases))</span>
                Timeline
            </h2>
        </div>
        <div class="netra-card__body">
            @if (c.Timeline.Count == 0)
            {
                <div class="netra-empty" style="padding:var(--netra-space-5) 0;">
                    <span class="netra-empty__icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Cases))</span>
                    <p class="netra-empty__title">No timeline events</p>
                </div>
            }
            else
            {
                @* Server-rendered ordered list. No client-side timeline library. *@
                <ol style="list-style:none;margin:0;padding:0;">
                    @foreach (var entry in c.Timeline)
                    {
                        <li style="position:relative;padding:0 0 var(--netra-space-4) var(--netra-space-5);">
                            <span style="position:absolute;left:0;top:4px;width:8px;height:8px;border-radius:50%;
                                         background:var(--netra-primary);"></span>
                            <div class="netra-row netra-row--between">
                                <span class="netra-table__primary">@entry.Title</span>
                                <span class="netra-faint netra-mono" style="font-size:11px;">
                                    @entry.EventDateTime.ToString("dd MMM yyyy HH:mm")
                                </span>
                            </div>
                            <div class="netra-row" style="gap:8px;margin-top:2px;">
                                <span class="netra-badge netra-badge--neutral">@entry.EventType</span>
                                @if (!string.IsNullOrWhiteSpace(entry.Location))
                                {
                                    <span class="netra-faint" style="font-size:11px;">@entry.Location</span>
                                }
                                <span class="netra-faint" style="font-size:11px;">@entry.AuthorName</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(entry.Description))
                            {
                                <p class="netra-muted" style="margin:4px 0 0;font-size:12px;">@entry.Description</p>
                            }
                        </li>
                    }
                </ol>
            }
        </div>

        @if (Model.CanManageTimeline)
        {
            <div class="netra-card__footer">
                <form asp-controller="Cases" asp-action="AddTimelineEvent" asp-route-caseId="@Model.CaseId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="netra-field" style="margin-bottom:8px;">
                        <label class="netra-label" for="WsEventTitle">Add timeline event</label>
                        <input class="netra-input" id="WsEventTitle" name="Title" type="text"
                               maxlength="200" required />
                    </div>
                    <div class="netra-row" style="gap:var(--netra-space-2);flex-wrap:wrap;">
                        <select class="netra-select" name="EventType" style="max-width:150px;" aria-label="Event type">
                            @foreach (var type in AddTimelineEventViewModel.EventTypes)
                            {
                                <option value="@type.Value">@type.Label</option>
                            }
                        </select>
                        <input class="netra-input" name="EventDateTime" type="datetime-local" required
                               style="max-width:210px;" aria-label="Event date and time" />
                        <button type="submit" class="netra-btn netra-btn--primary netra-btn--sm">Add event</button>
                    </div>
                </form>
            </div>
        }
    </div>

    <div class="netra-card">
        <div class="netra-card__header">
            <h2 class="netra-card__title">
                <span class="netra-card__title-icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Audit))</span>
                Investigation Notes
            </h2>
        </div>
        <div class="netra-card__body">
            @if (c.Notes.Count == 0)
            {
                <div class="netra-empty" style="padding:var(--netra-space-5) 0;">
                    <span class="netra-empty__icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Audit))</span>
                    <p class="netra-empty__title">No notes recorded</p>
                </div>
            }
            else
            {
                <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:var(--netra-space-3);">
                    @foreach (var note in c.Notes)
                    {
                        <li style="border-left:2px solid var(--netra-border-strong);padding-left:var(--netra-space-3);">
                            <div class="netra-row netra-row--between" style="margin-bottom:4px;">
                                <span class="netra-badge netra-badge--neutral">@note.NoteType</span>
                                <span class="netra-faint" style="font-size:11px;">@note.CreatedAt.ToString("dd MMM HH:mm")</span>
                            </div>
                            <p class="netra-muted" style="margin:0;">@note.Content</p>
                            <p class="netra-faint" style="margin:4px 0 0;font-size:11px;">@note.AuthorName</p>
                        </li>
                    }
                </ul>
            }
        </div>

        @if (Model.CanManageNotes)
        {
            <div class="netra-card__footer">
                <form asp-controller="Cases" asp-action="AddNote" asp-route-caseId="@Model.CaseId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="netra-field" style="margin-bottom:8px;">
                        <label class="netra-label" for="WsNoteContent">Add note</label>
                        <textarea class="netra-textarea" id="WsNoteContent" name="Content" maxlength="4000"
                                  rows="2" required></textarea>
                    </div>
                    <div class="netra-row" style="gap:var(--netra-space-2);">
                        <select class="netra-select" name="NoteType" style="max-width:150px;" aria-label="Note type">
                            @foreach (var type in AddInvestigationNoteViewModel.NoteTypes)
                            {
                                <option value="@type.Value">@type.Label</option>
                            }
                        </select>
                        <button type="submit" class="netra-btn netra-btn--primary netra-btn--sm">Add note</button>
                    </div>
                </form>
            </div>
        }
    </div>
</div>

@* ------------------------------------------------ EVIDENCE + RELATED *@
<div class="netra-grid netra-grid--2">
    <div class="netra-card">
        <div class="netra-card__header">
            <h2 class="netra-card__title">
                <span class="netra-card__title-icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Evidence))</span>
                Evidence
            </h2>
            <span class="netra-faint" style="font-size:11px;">@c.Evidence.Count item(s)</span>
        </div>
        <div class="netra-card__body netra-card__body--flush">
            @if (c.Evidence.Count == 0)
            {
                <div class="netra-empty">
                    <span class="netra-empty__icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Evidence))</span>
                    <p class="netra-empty__title">No evidence recorded</p>
                    <p class="netra-empty__text">Add evidence from the case detail page.</p>
                </div>
            }
            else
            {
                <div class="netra-tablewrap">
                    <table class="netra-table">
                        <caption class="netra-sr-only">Evidence for this investigation</caption>
                        <thead>
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col">Type</th>
                                <th scope="col">Collected</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in c.Evidence)
                            {
                                <tr>
                                    <td class="netra-table__primary">@item.Title</td>
                                    <td>@item.EvidenceType</td>
                                    <td>@(item.CollectedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="netra-card">
        <div class="netra-card__header">
            <h2 class="netra-card__title">
                <span class="netra-card__title-icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Network))</span>
                Related Information
            </h2>
        </div>
        <div class="netra-card__body">
            <p class="netra-muted" style="font-size:12.5px;">
                Network link analysis, image-assisted investigation and AI assistance are
                scheduled for later phases and are not part of this workspace.
            </p>
            <div class="netra-chips netra-mt-3">
                <span class="netra-chip">@Model.History.Count audit entr@(Model.History.Count == 1 ? "y" : "ies")</span>
                <span class="netra-chip">Opened @c.CreatedAt.ToString("dd MMM yyyy")</span>
                <span class="netra-chip">Investigation @Model.InvestigationId.ToString()[..8]</span>
            </div>
        </div>
    </div>
</div>