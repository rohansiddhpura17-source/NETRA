@using NETRA.Web.Models.Ui
@using NETRA.Web.Models.Navigation
@using NETRA.Web.Models.ViewModels.Reports
@model NETRA.Web.Models.ViewModels.Reports.ReportsIndexViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Reports";
}

@await Html.PartialAsync("_Breadcrumbs", new BreadcrumbsModel
{
    Items = new List<BreadcrumbItemModel>
    {
        new() { Text = "Intelligence", Url = null },
        new() { Text = "Reports", Url = null }
    }
})

@await Html.PartialAsync("_PageHeader", new PageHeaderModel
{
    Title = "Reports & Intelligence Summaries",
    Subtitle = "Access, generate and export automated intelligence briefings and data analyses. " +
        "Report content is assembled from recorded NETRA data and analytical indicators — " +
        "it is decision support for authorised personnel, never a finding of wrongdoing.",
    Actions = (HtmlString)Html.Raw(
        (Model.CanManage
            ? "<a class=\"netra-btn netra-btn--primary netra-btn--sm\" href=\"/reports/generate\">" +
              $"<span class=\"netra-btn__icon\">{NetraIconPaths.Render(NetraIcon.Plus)}</span>Generate New Report</a>"
            : string.Empty) +
        (Model.CanManage
            ? "<a class=\"netra-btn netra-btn--outline netra-btn--sm\" href=\"/reports/create\">" +
              $"<span class=\"netra-btn__icon\">{NetraIconPaths.Render(NetraIcon.Assistant)}</span>New Analyst Report</a>"
            : string.Empty))
})

@if (TempData["Netra.Success"] is string success)
{
    <div class="netra-alert netra-alert--success netra-mt-4" role="status">@success</div>
}
@if (TempData["Netra.Error"] is string failure)
{
    <div class="netra-alert netra-alert--danger netra-mt-4" role="alert">@failure</div>
}

<div class="netra-report-toolbar netra-mt-4">
    <nav class="netra-report-tabs" aria-label="Report groups">
        @foreach (var tab in Model.Tabs)
        {
            var active = Model.Filter.Group == tab.Value;
            <a class="netra-report-tabs__item@(active ? " is-active" : string.Empty)"
               asp-controller="Reports" asp-action="Index"
               asp-route-group="@tab.Value"
               aria-current="@(active ? "true" : null)">@tab.Label</a>
        }
    </nav>
    @if (Model.HasActiveFilters)
    {
        <a class="netra-btn netra-btn--ghost netra-btn--sm" asp-controller="Reports" asp-action="Index">
            Clear filters
        </a>
    }
</div>

@* Server-side GET filters. Every selected value is re-rendered into the form. *@
<form class="netra-filters netra-filters--band" id="report-filters"
      asp-controller="Reports" asp-action="Index" method="get" role="search">
    <input type="hidden" name="group" value="@Model.Filter.Group" />
    <div class="netra-filters__group netra-filters__group--wide">
        <label class="netra-label" for="search">Search reports</label>
        <input class="netra-input" type="search" id="search" name="search"
               value="@Model.Filter.Search"
               placeholder="Title, summary or author" maxlength="100" />
    </div>
    <div class="netra-filters__group">
        <label class="netra-label" for="type">Report type</label>
        <select class="netra-select" id="type" name="type">
            <option value="">All types</option>
            @foreach (var option in Model.TypeOptions)
            {
                <option value="@option.Value" selected="@(Model.Filter.Type == option.Value)">@option.Label</option>
            }
        </select>
    </div>
    <div class="netra-filters__group">
        <label class="netra-label" for="source">Prepared by</label>
        <select class="netra-select" id="source" name="source">
            <option value="">Any source</option>
            @foreach (var option in ReportsFilterViewModel.SourceOptions)
            {
                <option value="@option.Value" selected="@(Model.Filter.Source == option.Value)">@option.Label</option>
            }
        </select>
    </div>
    <div class="netra-filters__group">
        <label class="netra-label" for="status">Status</label>
        <select class="netra-select" id="status" name="status">
            <option value="">Any status</option>
            @foreach (var option in ReportsFilterViewModel.StatusOptions)
            {
                <option value="@option.Value" selected="@(Model.Filter.Status == option.Value)">@option.Label</option>
            }
        </select>
    </div>
    <div class="netra-filters__actions">
        <button type="submit" class="netra-btn netra-btn--primary netra-btn--sm">Apply Filters</button>
    </div>
</form>

<div class="netra-grid netra-grid--stats netra-mt-4">
    @foreach (var card in Model.SummaryCards)
    {
        @await Html.PartialAsync("_StatCard", card)
    }
</div>

<div class="netra-card netra-mt-4">
    <div class="netra-card__header">
        <h2 class="netra-card__title">
            <span class="netra-card__title-icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Report))</span>
            Report Library
        </h2>
        <span class="netra-badge netra-badge--neutral">@Model.TotalCount report@(Model.TotalCount == 1 ? "" : "s")</span>
    </div>
    <div class="netra-card__body">
        @if (Model.Reports.Count == 0)
        {
            @await Html.PartialAsync("_EmptyState", new EmptyStateModel
            {
                Title = Model.HasActiveFilters ? "No reports match the selected filters" : "No reports yet",
                Text = Model.HasActiveFilters
                    ? "No stored report matches this search, tab or filter combination. Clear the filters to see " +
                      "the full library, or generate a report for the period you need."
                    : "Reports are produced on demand: generate a system report from the recorded case, analytics, " +
                      "risk and alert data, or author a briefing yourself. Nothing here is fabricated to fill the page.",
                Icon = NetraIcon.Report,
                ActionText = Model.HasActiveFilters ? "Clear filters" : (Model.CanManage ? "Generate New Report" : null),
                ActionUrl = Model.HasActiveFilters ? "/reports" : (Model.CanManage ? "/reports/generate" : null)
            })
        }
        else
        {
            <div class="netra-reports">
                @foreach (var report in Model.Reports)
                {
                    <article class="netra-report-card netra-report-card--@report.Accent.ToString().ToLowerInvariant()">
                        <div class="netra-report-card__head">
                            <span class="netra-report-card__type">
                                <span class="netra-report-card__type-icon">@Html.Raw(NetraIconPaths.Render(NetraIcon.Report))</span>
                                @report.TypeLabel
                            </span>
                            <span class="netra-report-card__period">@report.PeriodBadge</span>
                        </div>

                        <h3 class="netra-report-card__title">
                            <a asp-controller="Reports" asp-action="Details" asp-route-id="@report.Id">@report.Title</a>
                        </h3>

                        @if (!string.IsNullOrWhiteSpace(report.Summary))
                        {
                            <p class="netra-report-card__summary">@report.Summary</p>
                        }

                        <div class="netra-report-card__badges">
                            @await Html.PartialAsync("_StatusBadge", new StatusBadgeModel
                                {
                                    Text = report.SourceLabel,
                                    Tone = report.SourceTone
                                })
                            @await Html.PartialAsync("_StatusBadge", new StatusBadgeModel
                                {
                                    Text = report.StatusLabel,
                                    Tone = report.StatusTone
                                })
                            @if (!string.IsNullOrWhiteSpace(report.CaseNumber))
                            {
                                <span class="netra-badge netra-badge--neutral">Case @report.CaseNumber</span>
                            }
                            <span class="netra-badge netra-badge--neutral">@report.SectionLabel</span>
                        </div>

                        <div class="netra-report-card__foot">
                            <span class="netra-report-card__author">
                                <span class="netra-report-card__author-label">Prepared</span>
                                <span class="netra-report-card__author-value">@report.AuthorLabel · @report.CreatedAtText</span>
                            </span>
                            <span class="netra-report-card__actions">
                                <a class="netra-btn netra-btn--primary netra-btn--sm"
                                   asp-controller="Reports" asp-action="Details" asp-route-id="@report.Id">View</a>
                                <a class="netra-btn netra-btn--ghost netra-btn--sm"
                                   asp-controller="Reports" asp-action="Export" asp-route-id="@report.Id">Export</a>
                                @if (Model.CanManage && report.CanEdit)
                                {
                                    <a class="netra-btn netra-btn--ghost netra-btn--sm"
                                       asp-controller="Reports" asp-action="Edit" asp-route-id="@report.Id">Edit</a>
                                }
                            </span>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>

@await Html.PartialAsync("_Pagination", Model.Pagination)
